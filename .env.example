# Copia este archivo como .env (Copy-Item .env.example .env) y cambia los valores.
# El archivo .env NO se sube a GitHub ni se entrega.
MYSQL_ROOT_PASSWORD=cambia_esta_clave_root
MYSQL_DATABASE=ingresos
MYSQL_USER=ingresos_user
MYSQL_PASSWORD=cambia_esta_clave_usuario
MYSQL_HOST_PORT=3307

# Clave para firmar el token de login (mínimo 32 caracteres)
SECRET_KEY=cambia-esta-clave-por-una-cadena-larga-y-aleatoria-de-32-o-mas

# Solo si ejecutas la API fuera de Docker (python -m uvicorn ...). Usa el mismo usuario/clave de arriba.
DATABASE_URL=mysql+pymysql://ingresos_user:cambia_esta_clave_usuario@localhost:3307/ingresos
